@model List<StaffTrack.Models.Entities.Employee>

@{
    ViewData["Title"] = "Employees";
}

<style>
    .employees-page {
        width: 100%;
        height: calc(100dvh - 123px);
        min-height: 0;
        display: flex;
        color: #0b1746;
        background: radial-gradient( circle at 82% 7%, rgba(107, 89, 255, 0.09), transparent 22% ), radial-gradient( circle at 12% 88%, rgba(71, 132, 255, 0.06), transparent 22% ), linear-gradient( 135deg, #ffffff 0%, #fbfcff 58%, #f8f8ff 100% );
        overflow: hidden;
    }

    .employees-shell {
        width: 100%;
        max-width: 1400px;
        height: 100%;
        min-height: 0;
        margin: 0 auto;
        padding: 16px 32px 14px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* =========================
           TOP
        ========================= */

    .employees-top {
        position: relative;
        flex: 0 0 auto;
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 12px;
    }

    .employees-heading {
        position: relative;
        z-index: 2;
    }

    .employees-kicker {
        margin-bottom: 3px;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 3.4px;
        color: #7e8bb6;
        text-transform: uppercase;
    }

    .employees-title {
        margin: 0;
        font-size: 40px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -2px;
        color: #0d184b;
    }

    .employees-subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: #62709d;
    }

    /* =========================
           DECORATION
        ========================= */

    .employees-decoration {
        position: absolute;
        width: 340px;
        height: 90px;
        right: 110px;
        top: -2px;
        pointer-events: none;
        opacity: .52;
    }

        .employees-decoration::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 52px;
            left: 10px;
            top: 2px;
            border-radius: 80px;
            transform: rotate(-26deg);
            background: linear-gradient( 90deg, rgba(115, 161, 255, .08), rgba(105, 93, 255, .28), rgba(164, 105, 255, .38) );
        }

        .employees-decoration::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 52px;
            right: 0;
            top: 30px;
            border-radius: 80px;
            transform: rotate(24deg);
            background: linear-gradient( 90deg, rgba(106, 144, 255, .05), rgba(105, 91, 255, .15), rgba(161, 116, 255, .06) );
        }

    /* =========================
           ADD BUTTON
        ========================= */

    .employees-top-action {
        position: relative;
        z-index: 3;
        flex-shrink: 0;
    }

    .add-employee-btn {
        height: 38px;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 8px;
        color: #ffffff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        background: linear-gradient( 100deg, #1b76ff 0%, #3e58ff 55%, #493df9 100% );
        box-shadow: 0 7px 18px rgba(58, 81, 255, .17);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .add-employee-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(58, 81, 255, .23);
        }

    /* =========================
           CARD
        ========================= */

    .employees-card {
        width: 100%;
        flex: 1;
        min-height: 0;
        position: relative;
        overflow: hidden;
        border: 1px solid #e8ecf7;
        border-radius: 16px;
        background: rgba(255, 255, 255, .89);
        backdrop-filter: blur(14px);
        box-shadow: 0 12px 32px rgba(51, 72, 132, .055);
    }

        .employees-card::before {
            content: "";
            position: absolute;
            left: -140px;
            bottom: -200px;
            width: 430px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient( circle at 60% 40%, rgba(117, 148, 255, .09), transparent 55% ), linear-gradient( 120deg, rgba(111, 166, 255, .05), rgba(121, 88, 255, .06) );
            pointer-events: none;
        }

    .employees-card-inner {
        width: 100%;
        height: 100%;
        min-height: 0;
        position: relative;
        z-index: 2;
        padding: 14px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* =========================
           TOOLBAR
        ========================= */

    .employee-tools {
        width: 100%;
        flex: 0 0 auto;
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 165px 145px auto;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .employee-search {
        height: 38px;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 0 12px;
        border: 1px solid #e7ebf6;
        border-radius: 9px;
        color: #7180ac;
        background: linear-gradient( 90deg, #f9faff, #f6f8ff );
    }

        .employee-search svg {
            flex-shrink: 0;
        }

        .employee-search input {
            width: 100%;
            padding: 0;
            border: 0;
            outline: none;
            color: #26345f;
            background: transparent;
            font-size: 12px;
        }

            .employee-search input::placeholder {
                color: #95a0bf;
            }

    .employee-filter {
        width: 100%;
        height: 38px;
        padding: 0 11px;
        border: 1px solid #dfe5f3;
        border-radius: 9px;
        outline: none;
        color: #20294f;
        background: #ffffff;
        font-size: 12px;
    }

    .employee-count {
        white-space: nowrap;
        text-align: right;
        color: #5e6ca0;
        font-size: 12px;
    }

    /* =========================
           TABLE
        ========================= */

    .table-wrap {
        width: 100%;
        flex: 1;
        min-height: 0;
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid #edf0f7;
        border-radius: 11px;
        background: rgba(255, 255, 255, .92);
    }

    .employees-table {
        width: 100%;
        min-width: 950px;
        border-collapse: collapse;
        table-layout: auto;
    }

        .employees-table thead {
            background: linear-gradient( 90deg, #f8faff, #f5f7fd );
        }

        .employees-table th {
            height: 38px;
            padding: 0 12px;
            border-bottom: 1px solid #edf0f7;
            text-align: left;
            color: #6877a7;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .employees-table td {
            height: 52px;
            padding: 6px 12px;
            border-bottom: 1px solid #edf0f7;
            vertical-align: middle;
            color: #17214e;
            font-size: 12px;
            white-space: nowrap;
        }

        .employees-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .employees-table tbody tr {
            transition: background .2s ease;
        }

            .employees-table tbody tr:hover {
                background: #fafbff;
            }

    /* =========================
           NAME
        ========================= */

    .employee-name-cell {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .employee-initials {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4d37db;
        font-size: 10px;
        font-weight: 700;
        background: linear-gradient( 145deg, #e5ebff, #e8dcff );
    }

    .employee-name-text {
        color: #121c49;
        font-weight: 600;
    }

    /* =========================
           DEPARTMENT
        ========================= */

    .department-badge {
        min-height: 25px;
        padding: 0 9px;
        display: inline-flex;
        align-items: center;
        border-radius: 6px;
        color: #265ed9;
        background: #e8f1ff;
        font-size: 10px;
        font-weight: 600;
    }

    /* =========================
           ACTIONS
        ========================= */

    .employee-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .employee-action {
        height: 30px;
        padding: 0 9px;
        border: 0;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        text-decoration: none;
        font-size: 10px;
        font-weight: 500;
        white-space: nowrap;
        cursor: pointer;
    }

    .action-detail {
        color: #145df7;
        background: linear-gradient( 90deg, #dceaff, #d4e3ff );
    }

        .action-detail:hover {
            color: #145df7;
        }

    .action-update {
        color: #805100;
        background: linear-gradient( 90deg, #ffecb8, #ffe39b );
    }

        .action-update:hover {
            color: #805100;
        }

    .action-delete {
        color: #d7183e;
        background: linear-gradient( 90deg, #ffe0e9, #ffd5e0 );
    }

    .delete-form {
        margin: 0;
    }

    /* =========================
           PAGINATION
        ========================= */

    .pagination-area {
        flex: 0 0 42px;
        min-height: 42px;
        padding-top: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .pagination-info {
        color: #7885aa;
        font-size: 11px;
    }

    .pagination {
        display: flex;
        align-items: center;
        gap: 5px;
        margin: 0;
    }

    .page-btn {
        min-width: 30px;
        height: 30px;
        padding: 0 8px;
        border: 1px solid #e0e5f2;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #52618f;
        background: #ffffff;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
    }

        .page-btn:hover:not(:disabled) {
            color: #315df5;
            border-color: #bfcaff;
            background: #f4f6ff;
        }

        .page-btn.active {
            color: #ffffff;
            border-color: transparent;
            background: linear-gradient( 135deg, #2772ff, #5b43f5 );
            box-shadow: 0 5px 12px rgba(62, 79, 255, .17);
        }

        .page-btn:disabled {
            opacity: .35;
            cursor: default;
        }

    .empty-row td {
        height: 160px;
        text-align: center;
        color: #8190b6;
    }

    .no-results-row {
        display: none;
    }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 1100px) {

        .employees-decoration {
            opacity: .35;
        }

        .employee-tools {
            grid-template-columns: minmax(220px, 1fr) 145px 135px auto;
        }
    }

    @@media (max-width: 900px) {

        .employees-page {
            height: calc(100dvh - 119px);
        }

        .employees-shell {
            padding: 14px 20px 12px;
        }

        .employees-decoration {
            display: none;
        }

        .employees-title {
            font-size: 36px;
        }

        .employee-tools {
            grid-template-columns: 1fr 1fr;
        }

        .employee-search {
            grid-column: 1 / -1;
        }

        .employee-count {
            text-align: left;
        }
    }

    @@media (max-width: 650px) {

        .employees-page {
            height: auto;
            min-height: calc(100dvh - 119px);
            overflow: visible;
        }

        .employees-shell {
            height: auto;
            overflow: visible;
        }

        .employees-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .employees-title {
            font-size: 34px;
        }

        .employees-top-action {
            width: 100%;
        }

        .add-employee-btn {
            width: 100%;
        }

        .employee-tools {
            grid-template-columns: 1fr;
        }

        .employee-search {
            grid-column: auto;
        }

        .employees-card,
        .employees-card-inner {
            overflow: visible;
        }

        .table-wrap {
            min-height: 300px;
        }

        .pagination-area {
            flex-direction: column;
            align-items: flex-start;
            height: auto;
            padding-bottom: 8px;
        }
    }
</style>

<section class="employees-page">

    <div class="employees-shell">

        <div class="employees-top">

            <div class="employees-heading">

                <div class="employees-kicker">
                    PEOPLE · ORGANIZATION · PROGRESS
                </div>

                <h1 class="employees-title">
                    Employees
                </h1>

                <p class="employees-subtitle">
                    View, manage and keep your team information up to date.
                </p>

            </div>

            <div class="employees-decoration"></div>

            <div class="employees-top-action">

                <a asp-controller="Employees"
                       asp-action="Add"
                       class="add-employee-btn">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>

                    </svg>

                    Add New Employee

                </a>

            </div>

        </div>

        <div class="employees-card">

            <div class="employees-card-inner">

                <div class="employee-tools">

                    <div class="employee-search">

                        <svg width="16"
                             height="16"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <circle cx="11"
                                    cy="11"
                                    r="8">
                            </circle>

                            <path d="m21 21-4.35-4.35"></path>

                        </svg>

                        <input id="employeeSearchInput"
                               type="text"
                               placeholder="Search by name, email or department..." />

                    </div>

                    <select id="departmentFilter"
                            class="employee-filter">

                        <option value="">
                            All Departments
                        </option>

                        @if (Model != null)
                        {
                            foreach (var department in Model
                                .Where(x => !string.IsNullOrWhiteSpace(x.Department))
                                .Select(x => x.Department)
                                .Distinct()
                                .OrderBy(x => x))
                            {
                                <option value="@department">
                                    @department
                                </option>
                            }
                        }

                    </select>

                    <select class="employee-filter"
                            disabled>

                        <option>
                            All Status
                        </option>

                    </select>

                    <div class="employee-count">

                        <span id="employeeCount">
                            @(Model?.Count ?? 0)
                        </span>

                        employees

                    </div>

                </div>

                <div class="table-wrap">

                    <table class="employees-table">

                        <thead>

                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Salary</th>
                                <th>Date of Birth</th>
                                <th>Department</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody id="employeesTableBody">

                            @if (Model != null && Model.Any())
                            {
                                var rowNumber = 1;

                                foreach (var employee in Model)
                                {
                                    var nameParts = (employee.Name ?? "")
                                        .Split(
                                            ' ',
                                            StringSplitOptions.RemoveEmptyEntries
                                        );

                                    var initials = "";

                                    if (nameParts.Length > 0)
                                    {
                                        initials += nameParts[0][0];
                                    }

                                    if (nameParts.Length > 1)
                                    {
                                        initials += nameParts[nameParts.Length - 1][0];
                                    }

                                    <tr class="employee-row"
                                        data-name="@employee.Name?.ToLower()"
                                        data-email="@employee.Email?.ToLower()"
                                        data-department="@employee.Department?.ToLower()">

                                        <td class="row-number">
                                            @rowNumber
                                        </td>

                                        <td>

                                            <div class="employee-name-cell">

                                                <div class="employee-initials">
                                                    @initials.ToUpper()
                                                </div>

                                                <span class="employee-name-text">
                                                    @employee.Name
                                                </span>

                                            </div>

                                        </td>

                                        <td>
                                            @employee.Email
                                        </td>

                                        <td>
                                            @employee.Salary.ToString("N0")
                                        </td>

                                        <td>
                                            @employee.DateOfBirth.ToString("dd-MM-yyyy")
                                        </td>

                                        <td>

                                            <span class="department-badge">
                                                @employee.Department
                                            </span>

                                        </td>

                                        <td>

                                            <div class="employee-actions">

                                                <a asp-controller="Employees"
                                                       asp-action="EmployeeDetail"
                                                       asp-route-id="@employee.Id"
                                                       class="employee-action action-detail">

                                                    <svg width="12"
                                                         height="12"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2">

                                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>

                                                        <circle cx="12"
                                                                cy="12"
                                                                r="3">
                                                        </circle>

                                                    </svg>

                                                    Detail

                                                </a>

                                                <a asp-controller="Employees"
                                                       asp-action="Update"
                                                       asp-route-id="@employee.Id"
                                                       class="employee-action action-update">

                                                    <svg width="12"
                                                         height="12"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2">

                                                        <path d="M12 20h9"></path>

                                                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"></path>

                                                    </svg>

                                                    Update

                                                </a>

                                                <form asp-controller="Employees"
                                                      asp-action="Delete"
                                                      asp-route-id="@employee.Id"
                                                      method="post"
                                                      class="delete-form"
                                                      onsubmit="return confirm('Are you sure you want to delete this employee?');">

                                                    <button type="submit"
                                                            class="employee-action action-delete">

                                                        <svg width="12"
                                                             height="12"
                                                             viewBox="0 0 24 24"
                                                             fill="none"
                                                             stroke="currentColor"
                                                             stroke-width="2">

                                                            <path d="M3 6h18"></path>
                                                            <path d="M8 6V4h8v2"></path>
                                                            <path d="M19 6l-1 14H6L5 6"></path>
                                                            <path d="M10 11v5"></path>
                                                            <path d="M14 11v5"></path>

                                                        </svg>

                                                        Delete

                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>

                                    rowNumber++;
                                }

                                <tr id="noResultsRow"
                                    class="empty-row no-results-row">

                                    <td colspan="7">
                                        No employees found.
                                    </td>

                                </tr>
                            }
                            else
                            {
                                <tr class="empty-row">

                                    <td colspan="7">
                                        No employees found.
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="pagination-area">

                    <div class="pagination-info"
                         id="paginationInfo">
                    </div>

                    <div class="pagination"
                         id="paginationControls">
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("employeeSearchInput");

        const departmentFilter =
            document.getElementById("departmentFilter");

        const employeeCount =
            document.getElementById("employeeCount");

        const paginationInfo =
            document.getElementById("paginationInfo");

        const paginationControls =
            document.getElementById("paginationControls");

        const noResultsRow =
            document.getElementById("noResultsRow");

        const rows =
            Array.from(
                document.querySelectorAll(".employee-row")
            );

        const pageSize = 5;

        let currentPage = 1;
        let filteredRows = [...rows];

        function filterEmployees() {

            const searchValue =
                searchInput.value
                    .trim()
                    .toLowerCase();

            const departmentValue =
                departmentFilter.value
                    .trim()
                    .toLowerCase();

            filteredRows =
                rows.filter(function (row) {

                    const name =
                        row.dataset.name || "";

                    const email =
                        row.dataset.email || "";

                    const department =
                        row.dataset.department || "";

                    const matchesSearch =
                        searchValue === "" ||
                        name.includes(searchValue) ||
                        email.includes(searchValue) ||
                        department.includes(searchValue);

                    const matchesDepartment =
                        departmentValue === "" ||
                        department === departmentValue;

                    return (
                        matchesSearch &&
                        matchesDepartment
                    );
                });

            currentPage = 1;

            renderTable();
        }

        function renderTable() {

            rows.forEach(function (row) {
                row.style.display = "none";
            });

            const totalItems =
                filteredRows.length;

            const totalPages =
                Math.max(
                    1,
                    Math.ceil(totalItems / pageSize)
                );

            if (currentPage > totalPages) {
                currentPage = totalPages;
            }

            const startIndex =
                (currentPage - 1) * pageSize;

            const endIndex =
                startIndex + pageSize;

            const currentRows =
                filteredRows.slice(
                    startIndex,
                    endIndex
                );

            currentRows.forEach(
                function (row, index) {

                    row.style.display = "";

                    const numberCell =
                        row.querySelector(
                            ".row-number"
                        );

                    if (numberCell) {

                        numberCell.textContent =
                            startIndex +
                            index +
                            1;
                    }
                }
            );

            employeeCount.textContent =
                totalItems;

            if (noResultsRow) {

                noResultsRow.style.display =
                    totalItems === 0
                        ? ""
                        : "none";
            }

            renderPagination(
                totalItems,
                totalPages,
                startIndex,
                currentRows.length
            );
        }

        function renderPagination(
            totalItems,
            totalPages,
            startIndex,
            visibleCount
        ) {

            paginationControls.innerHTML =
                "";

            if (totalItems === 0) {

                paginationInfo.textContent =
                    "No employees";

                return;
            }

            paginationInfo.textContent =
                `Showing ${startIndex + 1}-${startIndex + visibleCount} of ${totalItems}`;

            const previousButton =
                document.createElement(
                    "button"
                );

            previousButton.type =
                "button";

            previousButton.className =
                "page-btn";

            previousButton.innerHTML =
                "‹";

            previousButton.disabled =
                currentPage === 1;

            previousButton.addEventListener(
                "click",
                function () {

                    if (currentPage > 1) {

                        currentPage--;

                        renderTable();
                    }
                }
            );

            paginationControls.appendChild(
                previousButton
            );

            for (
                let page = 1;
                page <= totalPages;
                page++
            ) {

                const pageButton =
                    document.createElement(
                        "button"
                    );

                pageButton.type =
                    "button";

                pageButton.className =
                    "page-btn";

                if (
                    page ===
                    currentPage
                ) {

                    pageButton.classList.add(
                        "active"
                    );
                }

                pageButton.textContent =
                    page;

                pageButton.addEventListener(
                    "click",
                    function () {

                        currentPage =
                            page;

                        renderTable();
                    }
                );

                paginationControls.appendChild(
                    pageButton
                );
            }

            const nextButton =
                document.createElement(
                    "button"
                );

            nextButton.type =
                "button";

            nextButton.className =
                "page-btn";

            nextButton.innerHTML =
                "›";

            nextButton.disabled =
                currentPage === totalPages;

            nextButton.addEventListener(
                "click",
                function () {

                    if (
                        currentPage <
                        totalPages
                    ) {

                        currentPage++;

                        renderTable();
                    }
                }
            );

            paginationControls.appendChild(
                nextButton
            );
        }

        searchInput.addEventListener(
            "input",
            filterEmployees
        );

        departmentFilter.addEventListener(
            "change",
            filterEmployees
        );

        renderTable();

    });
</script>