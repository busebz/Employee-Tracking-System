@model StaffTrack.Models.ViewModels.UpdateEmployeeViewModel

@{
    ViewData["Title"] = "Update Employee";

    var nameParts = (Model.Name ?? "")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    var initials = nameParts.Length switch
    {
        0 => "",
        1 => nameParts[0][0].ToString(),
        _ => $"{nameParts[0][0]}{nameParts[^1][0]}"
    };
}

<style>
    :root {
        --update-white: #ffffff;
        --update-text: #10183f;
        --update-title: #0a1440;
        --update-muted: #6678aa;
        --update-primary: #1768ff;
        --update-border: #e6ebf6;
    }

    .update-page {
        width: 100%;
        height: calc(100dvh - 123px);
        min-height: 0;
        position: relative;
        overflow: hidden;
        color: var(--update-text);
        background: radial-gradient(circle at 77% 4%, rgba(111, 97, 255, .11), transparent 25%), linear-gradient(135deg, #ffffff 0%, #fbfcff 56%, #f7f9ff 100%);
    }

    .update-decoration {
        position: absolute;
        top: 0;
        right: 20px;
        width: 560px;
        height: 180px;
        pointer-events: none;
        opacity: .55;
    }

        .update-decoration::before,
        .update-decoration::after {
            content: "";
            position: absolute;
            height: 95px;
            border-radius: 50%;
        }

        .update-decoration::before {
            width: 350px;
            top: 0;
            left: 60px;
            transform: rotate(-22deg);
            background: linear-gradient(110deg, rgba(119, 163, 255, .08), rgba(119, 95, 255, .30), rgba(160, 121, 255, .23));
        }

        .update-decoration::after {
            width: 370px;
            top: 48px;
            right: 0;
            transform: rotate(18deg);
            background: linear-gradient(110deg, rgba(92, 153, 255, .07), rgba(91, 118, 255, .18), rgba(141, 114, 255, .07));
        }

    .update-shell {
        width: 100%;
        max-width: 1400px;
        height: 100%;
        min-height: 0;
        margin: 0 auto;
        padding: 14px 32px 12px;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .update-header {
        flex: 0 0 auto;
        margin-bottom: 12px;
    }

    .update-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 7px;
        color: #7283b3;
        font-size: 14px;
    }

        .update-breadcrumb a {
            color: #7283b3;
            text-decoration: none;
        }

            .update-breadcrumb a:hover {
                color: #2f67f7;
            }

    .update-breadcrumb-current {
        color: #25355f;
        font-weight: 500;
    }

    .update-title {
        margin: 0;
        color: var(--update-title);
        font-size: 46px;
        line-height: .98;
        font-weight: 800;
        letter-spacing: -2px;
    }

    .update-subtitle {
        margin: 8px 0 0;
        color: var(--update-muted);
        font-size: 16px;
    }

    .update-content {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 315px minmax(0, 1fr);
        gap: 16px;
        overflow: hidden;
    }

    .profile-card {
        height: 100%;
        min-height: 0;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--update-border);
        border-radius: 18px;
        background: rgba(255, 255, 255, .94);
        box-shadow: 0 14px 34px rgba(52, 72, 129, .07);
    }

        .profile-card::after {
            content: "";
            position: absolute;
            left: -110px;
            bottom: -115px;
            width: 340px;
            height: 170px;
            border-radius: 50%;
            transform: rotate(24deg);
            background: linear-gradient(115deg, rgba(91, 151, 255, .12), rgba(118, 98, 255, .20), rgba(160, 124, 255, .22));
        }

    .profile-inner {
        height: 100%;
        position: relative;
        z-index: 2;
        padding: 24px;
        display: flex;
        flex-direction: column;
    }

    .profile-main {
        text-align: center;
    }

    .profile-avatar {
        width: 96px;
        height: 96px;
        margin: 0 auto 12px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6937f5;
        background: linear-gradient(145deg, #e2dcff, #f0e8ff);
        font-size: 36px;
        font-weight: 800;
    }

    .profile-name {
        margin: 0 0 9px;
        color: #0e1640;
        font-size: 23px;
        font-weight: 800;
    }

    .profile-department {
        min-height: 31px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        color: #2f62df;
        background: #edf3ff;
        font-size: 13px;
        font-weight: 600;
    }

    .profile-divider {
        height: 1px;
        margin: 18px 0 16px;
        background: #e8edf6;
    }

    .profile-details {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .profile-detail {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profile-detail-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: var(--update-primary);
        background: linear-gradient(145deg, #f0f5ff, #e4edff);
    }

    .profile-detail-content {
        min-width: 0;
    }

    .profile-detail-value {
        color: #14204c;
        font-size: 14px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .profile-detail-label {
        margin-top: 2px;
        color: #7485b4;
        font-size: 12px;
    }

    .update-card {
        height: 100%;
        min-height: 0;
        overflow: hidden;
        border: 1px solid var(--update-border);
        border-radius: 18px;
        background: rgba(255, 255, 255, .95);
        box-shadow: 0 14px 34px rgba(52, 72, 129, .07);
    }

    .update-card-inner {
        width: 100%;
        height: 100%;
        min-height: 0;
        padding: 17px 24px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .form-top {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 12px;
    }

    .form-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .form-heading-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: var(--update-primary);
        background: linear-gradient(145deg, #eef4ff, #e1ebff);
    }

    .form-heading h2 {
        margin: 0;
        color: var(--update-text);
        font-size: 20px;
        font-weight: 700;
    }

    .back-detail-btn {
        height: 40px;
        padding: 0 16px;
        border: 1px solid #bdd0ff;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #125ff4;
        background: var(--update-white);
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .back-detail-btn:hover {
            color: #125ff4;
            background: #f7faff;
        }

    .employee-form {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .form-fields {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .field-group {
        width: 100%;
    }

    .field-label {
        display: block;
        margin-bottom: 3px;
        color: #13204b;
        font-size: 14px;
        font-weight: 500;
    }

    .field-control {
        width: 100%;
        height: 43px;
        display: flex;
        align-items: stretch;
        overflow: hidden;
        border: 1px solid #dce4f3;
        border-radius: 8px;
        background: var(--update-white);
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .field-control:focus-within {
            border-color: #7da5ff;
            box-shadow: 0 0 0 3px rgba(57, 105, 255, .07);
        }

    .field-icon {
        width: 47px;
        flex: 0 0 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--update-primary);
        background: linear-gradient(135deg, #f1f6ff, #e7efff);
    }

    .field-input {
        width: 100%;
        height: 100%;
        padding: 0 14px;
        border: 0;
        outline: 0;
        color: #243459;
        background: var(--update-white);
        font-size: 14px;
    }

    .field-validation {
        display: none;
        margin-top: 2px;
        color: #d7334f;
        font-size: 10px;
    }

        .field-validation:not(:empty) {
            display: block;
        }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        flex: 0 0 auto;
        margin-bottom: 7px;
        padding: 7px 10px;
        border: 1px solid #ffd5de;
        border-radius: 7px;
        color: #c82d48;
        background: #fff6f8;
        font-size: 11px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 16px;
        }

    .form-actions {
        flex: 0 0 auto;
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid #e8edf6;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .update-btn {
        height: 41px;
        min-width: 180px;
        padding: 0 18px;
        border: 0;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--update-white);
        background: linear-gradient(100deg, #2681ff 0%, #1266ff 62%, #3157f6 100%);
        box-shadow: 0 8px 19px rgba(34, 104, 255, .20);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .cancel-btn {
        height: 41px;
        min-width: 95px;
        padding: 0 16px;
        border: 1px solid #cad6eb;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #344f87;
        background: var(--update-white);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
    }

        .cancel-btn:hover {
            color: #294575;
            background: #f8faff;
        }

    @@media (max-height: 760px) and (min-width: 701px) {
        .update-shell {
            padding-top: 9px;
            padding-bottom: 8px;
        }

        .update-header {
            margin-bottom: 8px;
        }

        .update-breadcrumb {
            margin-bottom: 3px;
        }

        .update-title {
            font-size: 39px;
        }

        .update-subtitle {
            margin-top: 4px;
            font-size: 13px;
        }

        .update-content {
            grid-template-columns: 285px minmax(0, 1fr);
            gap: 11px;
        }

        .profile-inner {
            padding: 17px 20px;
        }

        .profile-avatar {
            width: 78px;
            height: 78px;
            margin-bottom: 8px;
            font-size: 29px;
        }

        .profile-name {
            font-size: 20px;
        }

        .profile-divider {
            margin: 12px 0;
        }

        .profile-details {
            gap: 10px;
        }

        .profile-detail-value {
            font-size: 13px;
        }

        .update-card-inner {
            padding: 11px 20px;
        }

        .form-top {
            margin-bottom: 8px;
        }

        .form-heading-icon {
            width: 36px;
            height: 36px;
            flex-basis: 36px;
        }

        .form-heading h2 {
            font-size: 18px;
        }

        .back-detail-btn {
            height: 34px;
            font-size: 12px;
        }

        .form-fields {
            gap: 5px;
        }

        .field-label {
            margin-bottom: 2px;
            font-size: 13px;
        }

        .field-control {
            height: 36px;
        }

        .field-icon {
            width: 41px;
            flex-basis: 41px;
        }

        .field-input {
            font-size: 13px;
        }

        .form-actions {
            padding-top: 7px;
        }

        .update-btn,
        .cancel-btn {
            height: 35px;
            font-size: 12px;
        }
    }

    @@media (max-width: 900px) {
        .update-page {
            height: auto;
            min-height: calc(100dvh - 119px);
            overflow: visible;
        }

        .update-shell {
            height: auto;
            padding: 18px 20px;
            overflow: visible;
        }

        .update-content {
            display: block;
            overflow: visible;
        }

        .profile-card,
        .update-card {
            height: auto;
        }

        .profile-card {
            margin-bottom: 14px;
        }

        .profile-inner {
            height: auto;
        }

        .profile-main {
            display: flex;
            align-items: center;
            gap: 15px;
            text-align: left;
        }

        .profile-avatar {
            margin: 0;
            flex-shrink: 0;
        }

        .update-card-inner {
            height: auto;
            overflow: visible;
        }

        .update-decoration {
            opacity: .3;
        }
    }

    @@media (max-width: 600px) {
        .update-shell {
            padding: 16px;
        }

        .update-decoration {
            display: none;
        }

        .update-title {
            font-size: 36px;
        }

        .form-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .back-detail-btn {
            width: 100%;
        }

        .field-label {
            font-size: 14px;
        }

        .field-control {
            height: 45px;
        }

        .field-input {
            font-size: 14px;
        }

        .form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .update-btn,
        .cancel-btn {
            width: 100%;
            height: 43px;
        }
    }
</style>

<section class="update-page">
    <div class="update-decoration"></div>

    <div class="update-shell">
        <div class="update-header">
            <div class="update-breadcrumb">
                <a asp-controller="Employees"
                       asp-action="Index">
                    Employees
                </a>

                <svg width="12"
                     height="12"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">
                    <path d="m9 18 6-6-6-6"></path>
                </svg>

                <span class="update-breadcrumb-current">
                    Update Employee
                </span>
            </div>

            <h1 class="update-title">
                Update Employee
            </h1>

            <p class="update-subtitle">
                Edit the employee information and save the changes.
            </p>
        </div>

        <div class="update-content">
            <aside class="profile-card">
                <div class="profile-inner">
                    <div class="profile-main">
                        <div class="profile-avatar">
                            @initials.ToUpper()
                        </div>

                        <div>
                            <h2 class="profile-name">
                                @Model.Name
                            </h2>

                            <span class="profile-department">
                                @Model.Department
                            </span>
                        </div>
                    </div>

                    <div class="profile-divider"></div>

                    <div class="profile-details">
                        <div class="profile-detail">
                            <div class="profile-detail-icon">
                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.9">
                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2">
                                    </rect>

                                    <path d="m3 7 9 6 9-6"></path>
                                </svg>
                            </div>

                            <div class="profile-detail-content">
                                <div class="profile-detail-value">
                                    @Model.Email
                                </div>

                                <div class="profile-detail-label">
                                    Email
                                </div>
                            </div>
                        </div>

                        <div class="profile-detail">
                            <div class="profile-detail-icon">
                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">
                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="16"
                                          rx="2">
                                    </rect>

                                    <path d="M16 3v4"></path>
                                    <path d="M8 3v4"></path>
                                    <path d="M3 10h18"></path>
                                </svg>
                            </div>

                            <div class="profile-detail-content">
                                <div class="profile-detail-value">
                                    @Model.DateOfBirth.ToString("dd-MM-yyyy")
                                </div>

                                <div class="profile-detail-label">
                                    Date of Birth
                                </div>
                            </div>
                        </div>

                        <div class="profile-detail">
                            <div class="profile-detail-icon">
                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">
                                    <path d="M4 21V4h11v17"></path>
                                    <path d="M15 9h5v12"></path>
                                    <path d="M8 8h2"></path>
                                    <path d="M8 12h2"></path>
                                    <path d="M8 16h2"></path>
                                    <path d="M3 21h18"></path>
                                </svg>
                            </div>

                            <div class="profile-detail-content">
                                <div class="profile-detail-value">
                                    @Model.Department
                                </div>

                                <div class="profile-detail-label">
                                    Department
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <section class="update-card">
                <div class="update-card-inner">
                    <div class="form-top">
                        <div class="form-heading">
                            <div class="form-heading-icon">
                                <svg width="20"
                                     height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.9">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"></path>
                                </svg>
                            </div>

                            <h2>
                                Employee Information
                            </h2>
                        </div>

                        <a asp-controller="Employees"
                               asp-action="EmployeeDetail"
                               asp-route-id="@Model.Id"
                               class="back-detail-btn">
                            <svg width="15"
                                 height="15"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <path d="M19 12H5"></path>
                                <path d="m12 19-7-7 7-7"></path>
                            </svg>

                            Back to Employee Detail
                        </a>
                    </div>

                    <form asp-controller="Employees"
                          asp-action="Update"
                          method="post"
                          class="employee-form">

                        <input asp-for="Id"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary-errors">
                        </div>

                        <div class="form-fields">
                            <div class="field-group">
                                <label asp-for="Name"
                                       class="field-label">
                                    Name
                                </label>

                                <div class="field-control">
                                    <div class="field-icon">
                                        <svg width="17"
                                             height="17"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.9">
                                            <circle cx="12"
                                                    cy="7"
                                                    r="4">
                                            </circle>

                                            <path d="M5.5 21v-2a6.5 6.5 0 0 1 13 0v2"></path>
                                        </svg>
                                    </div>

                                    <input asp-for="Name"
                                           class="field-input" />
                                </div>

                                <span asp-validation-for="Name"
                                      class="field-validation">
                                </span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Email"
                                       class="field-label">
                                    Email Address
                                </label>

                                <div class="field-control">
                                    <div class="field-icon">
                                        <svg width="17"
                                             height="17"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.9">
                                            <rect x="3"
                                                  y="5"
                                                  width="18"
                                                  height="14"
                                                  rx="2">
                                            </rect>

                                            <path d="m3 7 9 6 9-6"></path>
                                        </svg>
                                    </div>

                                    <input asp-for="Email"
                                           type="email"
                                           class="field-input" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="field-validation">
                                </span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Salary"
                                       class="field-label">
                                    Salary
                                </label>

                                <div class="field-control">
                                    <div class="field-icon">
                                        <svg width="17"
                                             height="17"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8">
                                            <ellipse cx="9"
                                                     cy="6"
                                                     rx="5"
                                                     ry="2">
                                            </ellipse>

                                            <path d="M4 6v4c0 1.1 2.2 2 5 2"></path>

                                            <ellipse cx="15"
                                                     cy="14"
                                                     rx="5"
                                                     ry="2">
                                            </ellipse>

                                            <path d="M10 14v4c0 1.1 2.2 2 5 2s5-.9 5-2v-4"></path>
                                        </svg>
                                    </div>

                                    <input asp-for="Salary"
                                           type="number"
                                           min="1"
                                           class="field-input" />
                                </div>

                                <span asp-validation-for="Salary"
                                      class="field-validation">
                                </span>
                            </div>

                            <div class="field-group">
                                <label asp-for="DateOfBirth"
                                       class="field-label">
                                    Date of Birth
                                </label>

                                <div class="field-control">
                                    <div class="field-icon">
                                        <svg width="17"
                                             height="17"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8">
                                            <rect x="3"
                                                  y="5"
                                                  width="18"
                                                  height="16"
                                                  rx="2">
                                            </rect>

                                            <path d="M16 3v4"></path>
                                            <path d="M8 3v4"></path>
                                            <path d="M3 10h18"></path>
                                        </svg>
                                    </div>

                                    <input asp-for="DateOfBirth"
                                           type="date"
                                           class="field-input" />
                                </div>

                                <span asp-validation-for="DateOfBirth"
                                      class="field-validation">
                                </span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Department"
                                       class="field-label">
                                    Department
                                </label>

                                <div class="field-control">
                                    <div class="field-icon">
                                        <svg width="17"
                                             height="17"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8">
                                            <path d="M4 21V4h11v17"></path>
                                            <path d="M15 9h5v12"></path>
                                            <path d="M8 8h2"></path>
                                            <path d="M8 12h2"></path>
                                            <path d="M8 16h2"></path>
                                            <path d="M3 21h18"></path>
                                        </svg>
                                    </div>

                                    <input asp-for="Department"
                                           class="field-input"
                                           list="departmentOptions" />

                                    <datalist id="departmentOptions">
                                        <option value="IT"></option>
                                        <option value="Human Resources"></option>
                                        <option value="Finance"></option>
                                        <option value="Marketing"></option>
                                        <option value="Sales"></option>
                                        <option value="Operations"></option>
                                    </datalist>
                                </div>

                                <span asp-validation-for="Department"
                                      class="field-validation">
                                </span>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit"
                                    class="update-btn">
                                <svg width="15"
                                     height="15"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                    <path d="M17 21v-8H7v8"></path>
                                    <path d="M7 3v5h8"></path>
                                </svg>

                                Update Employee
                            </button>

                            <a asp-controller="Employees"
                                   asp-action="EmployeeDetail"
                                   asp-route-id="@Model.Id"
                                   class="cancel-btn">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}