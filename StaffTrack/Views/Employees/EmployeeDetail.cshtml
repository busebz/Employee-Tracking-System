@model StaffTrack.Models.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Employee Detail";

    var nameParts = (Model.Name ?? "")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    var initials = nameParts.Length switch
    {
        0 => "",
        1 => nameParts[0][0].ToString(),
        _ => $"{nameParts[0][0]}{nameParts[^1][0]}"
    };
}

<style>
    :root {
        --detail-white: #ffffff;
        --detail-text: #10183f;
        --detail-title: #0a1440;
        --detail-muted: #6678aa;
        --detail-primary: #1768ff;
        --detail-border: #e5eaf5;
        --detail-row-border: #e9edf5;
    }

    .detail-page {
        width: 100%;
        height: calc(100dvh - 123px);
        min-height: 0;
        position: relative;
        overflow: hidden;
        color: var(--detail-text);
        background: radial-gradient( circle at 75% 5%, rgba(108, 95, 255, .10), transparent 25% ), linear-gradient( 135deg, #ffffff 0%, #fbfcff 56%, #f7f9ff 100% );
    }

    .detail-decoration {
        position: absolute;
        top: 0;
        right: 10px;
        width: 570px;
        height: 190px;
        pointer-events: none;
        opacity: .55;
    }

        .detail-decoration::before,
        .detail-decoration::after {
            content: "";
            position: absolute;
            border-radius: 50%;
        }

        .detail-decoration::before {
            width: 360px;
            height: 100px;
            top: 2px;
            left: 50px;
            transform: rotate(-23deg);
            background: linear-gradient( 110deg, rgba(119, 163, 255, .08), rgba(119, 95, 255, .29), rgba(160, 121, 255, .22) );
        }

        .detail-decoration::after {
            width: 390px;
            height: 100px;
            top: 52px;
            right: 0;
            transform: rotate(18deg);
            background: linear-gradient( 110deg, rgba(92, 153, 255, .07), rgba(91, 118, 255, .17), rgba(141, 114, 255, .07) );
        }

    .detail-shell {
        width: 100%;
        max-width: 1400px;
        height: 100%;
        min-height: 0;
        margin: 0 auto;
        padding: 14px 32px 12px;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .detail-header {
        flex: 0 0 auto;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 14px;
    }

    .detail-header-left {
        min-width: 0;
    }

    .detail-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 7px;
        color: #7283b3;
        font-size: 14px;
    }

        .detail-breadcrumb a {
            color: #7283b3;
            text-decoration: none;
        }

            .detail-breadcrumb a:hover {
                color: #2f67f7;
            }

    .detail-breadcrumb-current {
        color: #25355f;
        font-weight: 500;
    }

    .detail-title {
        margin: 0;
        color: var(--detail-title);
        font-size: 45px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -2px;
    }

    .detail-subtitle {
        margin: 8px 0 0;
        color: var(--detail-muted);
        font-size: 16px;
    }

    .back-list-btn {
        height: 43px;
        padding: 0 17px;
        flex-shrink: 0;
        border: 1px solid #bdd0ff;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #125ff4;
        background: rgba(255, 255, 255, .94);
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: background .2s ease, border-color .2s ease;
    }

        .back-list-btn:hover {
            color: #125ff4;
            background: #f7faff;
            border-color: #9db8ff;
        }

    .detail-content {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 315px minmax(0, 1fr);
        gap: 16px;
        overflow: hidden;
    }

    .profile-card {
        height: 100%;
        min-height: 0;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--detail-border);
        border-radius: 18px;
        background: rgba(255, 255, 255, .94);
        box-shadow: 0 14px 34px rgba(52, 72, 129, .065);
    }

        .profile-card::after {
            content: "";
            position: absolute;
            left: -105px;
            bottom: -110px;
            width: 345px;
            height: 170px;
            border-radius: 50%;
            transform: rotate(24deg);
            background: linear-gradient( 115deg, rgba(91, 151, 255, .12), rgba(118, 98, 255, .20), rgba(160, 124, 255, .22) );
        }

    .profile-inner {
        height: 100%;
        position: relative;
        z-index: 2;
        padding: 28px 25px;
        display: flex;
        flex-direction: column;
    }

    .profile-main {
        text-align: center;
    }

    .profile-avatar {
        width: 102px;
        height: 102px;
        margin: 0 auto 14px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6937f5;
        font-size: 38px;
        font-weight: 800;
        background: linear-gradient(145deg, #e2dcff, #f0e8ff);
    }

    .profile-name {
        margin: 0 0 10px;
        color: #0e1640;
        font-size: 23px;
        font-weight: 800;
    }

    .profile-department {
        min-height: 31px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        color: #2f62df;
        background: #edf3ff;
        font-size: 13px;
        font-weight: 600;
    }

    .profile-divider {
        height: 1px;
        margin: 21px 0 18px;
        background: #e8edf6;
    }

    .profile-details {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .profile-detail {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profile-detail-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: var(--detail-primary);
        background: linear-gradient(145deg, #f0f5ff, #e4edff);
    }

    .profile-detail-content {
        min-width: 0;
        text-align: left;
    }

    .profile-detail-value {
        color: #14204c;
        font-size: 14px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .profile-detail-label {
        margin-top: 2px;
        color: #7485b4;
        font-size: 12px;
    }

    .information-card {
        height: 100%;
        min-height: 0;
        padding: 20px;
        border: 1px solid var(--detail-border);
        border-radius: 18px;
        background: rgba(255, 255, 255, .94);
        box-shadow: 0 14px 34px rgba(52, 72, 129, .065);
        overflow: hidden;
    }

    .information-inner {
        width: 100%;
        height: 100%;
        min-height: 0;
        padding: 18px 22px;
        border: 1px solid #e8edf6;
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        background: rgba(255, 255, 255, .82);
    }

    .information-title {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 22px;
    }

    .information-title-icon {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--detail-primary);
        background: linear-gradient(145deg, #eef4ff, #e1ebff);
    }

    .information-title h2 {
        margin: 0;
        color: var(--detail-text);
        font-size: 20px;
        font-weight: 700;
    }

    .information-list {
        width: 100%;
    }

    .information-row {
        min-height: 58px;
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        align-items: center;
        gap: 26px;
        border-bottom: 1px solid var(--detail-row-border);
    }

        .information-row:last-child {
            border-bottom: 0;
        }

    .information-label {
        color: #536796;
        font-size: 14px;
        font-weight: 600;
    }

    .information-value {
        color: #131f4b;
        font-size: 15px;
        font-weight: 500;
    }

    .detail-department-badge {
        min-height: 31px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        color: #2764e5;
        background: #eaf2ff;
        font-size: 13px;
        font-weight: 600;
    }

    @@media (max-height: 760px) and (min-width: 701px) {
        .detail-shell {
            padding-top: 9px;
            padding-bottom: 8px;
        }

        .detail-header {
            margin-bottom: 9px;
        }

        .detail-breadcrumb {
            margin-bottom: 4px;
            font-size: 12px;
        }

        .detail-title {
            font-size: 38px;
        }

        .detail-subtitle {
            margin-top: 5px;
            font-size: 13px;
        }

        .back-list-btn {
            height: 37px;
            font-size: 12px;
        }

        .detail-content {
            grid-template-columns: 285px minmax(0, 1fr);
            gap: 12px;
        }

        .profile-inner {
            padding: 18px 21px;
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            margin-bottom: 9px;
            font-size: 30px;
        }

        .profile-name {
            margin-bottom: 7px;
            font-size: 20px;
        }

        .profile-divider {
            margin: 13px 0;
        }

        .profile-details {
            gap: 11px;
        }

        .profile-detail-icon {
            width: 36px;
            height: 36px;
            flex-basis: 36px;
        }

        .profile-detail-value {
            font-size: 13px;
        }

        .information-card {
            padding: 14px;
        }

        .information-inner {
            padding: 13px 18px;
        }

        .information-title {
            margin-bottom: 13px;
        }

        .information-title-icon {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
        }

        .information-title h2 {
            font-size: 18px;
        }

        .information-row {
            min-height: 50px;
            grid-template-columns: 190px minmax(0, 1fr);
        }

        .information-label {
            font-size: 13px;
        }

        .information-value {
            font-size: 14px;
        }
    }

    @@media (max-width: 900px) {
        .detail-page {
            height: auto;
            min-height: calc(100dvh - 119px);
            overflow: visible;
        }

        .detail-shell {
            height: auto;
            padding: 18px 20px;
            overflow: visible;
        }

        .detail-header {
            align-items: flex-start;
        }

        .detail-content {
            display: block;
            overflow: visible;
        }

        .profile-card,
        .information-card {
            height: auto;
        }

        .profile-card {
            margin-bottom: 14px;
        }

        .profile-inner {
            height: auto;
        }

        .profile-main {
            display: flex;
            align-items: center;
            gap: 16px;
            text-align: left;
        }

        .profile-avatar {
            margin: 0;
            flex-shrink: 0;
        }

        .detail-decoration {
            opacity: .28;
        }
    }

    @@media (max-width: 600px) {
        .detail-shell {
            padding: 16px;
        }

        .detail-decoration {
            display: none;
        }

        .detail-header {
            flex-direction: column;
            align-items: stretch;
        }

        .detail-title {
            font-size: 35px;
        }

        .detail-subtitle {
            font-size: 14px;
        }

        .back-list-btn {
            width: 100%;
        }

        .profile-main {
            align-items: center;
        }

        .profile-name {
            font-size: 19px;
        }

        .information-card {
            padding: 12px;
        }

        .information-inner {
            padding: 16px;
        }

        .information-row {
            grid-template-columns: 1fr;
            gap: 5px;
            padding: 13px 0;
        }

        .information-label {
            font-size: 12px;
        }

        .information-value {
            font-size: 14px;
        }
    }
</style>

<section class="detail-page">
    <div class="detail-decoration"></div>

    <div class="detail-shell">
        <div class="detail-header">
            <div class="detail-header-left">
                <div class="detail-breadcrumb">
                    <a asp-controller="Employees"
                           asp-action="Index">
                        Employees
                    </a>

                    <svg width="12"
                         height="12"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>

                    <span class="detail-breadcrumb-current">
                        Employee Detail
                    </span>
                </div>

                <h1 class="detail-title">
                    Employee Information
                </h1>

                <p class="detail-subtitle">
                    View detailed information about the employee.
                </p>
            </div>

            <a asp-controller="Employees"
                   asp-action="Index"
                   class="back-list-btn">
                <svg width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">
                    <path d="M19 12H5"></path>
                    <path d="m12 19-7-7 7-7"></path>
                </svg>

                Back to Employees List
            </a>
        </div>

        <div class="detail-content">
            <aside class="profile-card">
                <div class="profile-inner">
                    <div class="profile-main">
                        <div class="profile-avatar">
                            @initials.ToUpper()
                        </div>

                        <div>
                            <h2 class="profile-name">
                                @Model.Name
                            </h2>

                            <span class="profile-department">
                                @Model.Department
                            </span>
                        </div>
                    </div>

                    <div class="profile-divider"></div>

                    <div class="profile-details">
                        <div class="profile-detail">
                            <div class="profile-detail-icon">
                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.9">
                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2">
                                    </rect>

                                    <path d="m3 7 9 6 9-6"></path>
                                </svg>
                            </div>

                            <div class="profile-detail-content">
                                <div class="profile-detail-value">
                                    @Model.Email
                                </div>

                                <div class="profile-detail-label">
                                    Email
                                </div>
                            </div>
                        </div>

                        <div class="profile-detail">
                            <div class="profile-detail-icon">
                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">
                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="16"
                                          rx="2">
                                    </rect>

                                    <path d="M16 3v4"></path>
                                    <path d="M8 3v4"></path>
                                    <path d="M3 10h18"></path>
                                </svg>
                            </div>

                            <div class="profile-detail-content">
                                <div class="profile-detail-value">
                                    @Model.DateOfBirth.ToString("dd-MM-yyyy")
                                </div>

                                <div class="profile-detail-label">
                                    Date of Birth
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <section class="information-card">
                <div class="information-inner">
                    <div class="information-title">
                        <div class="information-title-icon">
                            <svg width="21"
                                 height="21"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.9">
                                <circle cx="12"
                                        cy="7"
                                        r="4">
                                </circle>

                                <path d="M5.5 21v-2a6.5 6.5 0 0 1 13 0v2"></path>
                            </svg>
                        </div>

                        <h2>
                            Personal & Work Information
                        </h2>
                    </div>

                    <div class="information-list">
                        <div class="information-row">
                            <div class="information-label">
                                Name
                            </div>

                            <div class="information-value">
                                @Model.Name
                            </div>
                        </div>

                        <div class="information-row">
                            <div class="information-label">
                                Email
                            </div>

                            <div class="information-value">
                                @Model.Email
                            </div>
                        </div>

                        <div class="information-row">
                            <div class="information-label">
                                Salary
                            </div>

                            <div class="information-value">
                                @Model.Salary.ToString("N0")
                            </div>
                        </div>

                        <div class="information-row">
                            <div class="information-label">
                                Date of Birth
                            </div>

                            <div class="information-value">
                                @Model.DateOfBirth.ToString("dd-MM-yyyy")
                            </div>
                        </div>

                        <div class="information-row">
                            <div class="information-label">
                                Department
                            </div>

                            <div class="information-value">
                                <span class="detail-department-badge">
                                    @Model.Department
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</section>